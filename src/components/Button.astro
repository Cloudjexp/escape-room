---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: string;
  size?: "sm" | "md" | "lg";
  fullWidth?: boolean;
  disabled?: boolean;
  id?: string;
  className?: string;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  fullWidth = false,
  disabled = false,
  id,
  className = "",
} = Astro.props;

const BASE_URL = import.meta.env.BASE_URL;

const finalHref = href
  ? href.startsWith("http") || href.startsWith("#")
    ? href
    : `${BASE_URL}${href.replace(/^\//, "")}`
  : undefined;

const variants: Record<string, string> = {
  primary:
    "bg-yellow-400 text-black hover:bg-yellow-300 rounded-xl font-bold transition",
  ghost:
    "border border-slate-600 text-white hover:bg-slate-800 rounded-xl transition",
};

const sizes: Record<string, string> = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-3 text-base",
  lg: "px-8 py-4 text-lg",
};

const classes = [
  variants[variant] ?? variants.primary,
  sizes[size],
  fullWidth ? "w-full" : "",
].join(" ");
---

{
  href ? (
    <a href={finalHref} id={id} class={`${classes} ${className}`}>
      <slot />
    </a>
  ) : (
    <button
      type={type}
      id={id}
      disabled={disabled}
      class={`${classes} ${className}`}
    >
      <slot />
    </button>
  )
}