---
import { CHALLENGES } from "../data/challenges";
import { withBase } from "../utils/url";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={withBase("/")} class="flex items-center gap-2 font-display text-lg font-bold text-gold-400 sm:text-xl">
      <span aria-hidden="true">🏰</span>
      <span class="hidden sm:inline">The Haunted Castle</span>
      <span class="sm:hidden">Escape Room</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-5">
      <div id="nav-timer" class="hidden items-center gap-1.5 rounded-full border border-border bg-panel px-3 py-1.5 font-mono text-sm text-azure-300 sm:flex">
        <span aria-hidden="true">⏱️</span>
        <span id="nav-timer-value">00:00</span>
      </div>

      <div class="flex items-center gap-1.5" aria-label="Challenge progress">
        {CHALLENGES.map((c) => (
          <span
            class="nav-dot flex h-6 w-6 items-center justify-center rounded-full border border-border bg-panel text-[11px] font-bold text-slate-400 transition-colors"
            data-challenge-id={c.id}
            title={`Challenge ${c.id}: ${c.subtitle}`}
          >
            {c.id}
          </span>
        ))}
      </div>

      <a
        href={withBase("/story")}
        class="hidden rounded-lg border border-gold-600/50 px-3 py-1.5 text-sm font-semibold text-gold-300 transition hover:bg-gold-500/10 md:inline-block"
      >
        Story
      </a>
    </div>
  </nav>
</header>

<script>
  import { getProgress, formatElapsed } from "../scripts/gameState";

  function paintProgress() {
    const progress = getProgress();

    document.querySelectorAll<HTMLElement>(".nav-dot").forEach((dot) => {
      const id = Number(dot.dataset.challengeId);
      if (progress.completed[id]) {
        dot.classList.add("border-gold-500", "bg-gold-500/20", "text-gold-300");
        dot.classList.remove("text-slate-400");
        dot.textContent = "✓";
      }
    });

    const timerEl = document.getElementById("nav-timer");
    const timerValue = document.getElementById("nav-timer-value");
    if (!timerEl || !timerValue) return;

    if (progress.startTime) {
      timerEl.classList.remove("hidden");
      timerEl.classList.add("flex");
      const tick = () => {
        const end = progress.finishTime ?? Date.now();
        timerValue.textContent = formatElapsed(end - (progress.startTime as number));
      };
      tick();
      if (!progress.finishTime) {
        setInterval(tick, 1000);
      }
    }
  }

  paintProgress();
</script>
