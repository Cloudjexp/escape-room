---
// Self-contained progress bar: reads challenge completion from
// localStorage on mount and paints itself — no props required.

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class={`w-full ${className}`}>
  <div class="mb-1.5 flex items-center justify-between text-xs font-semibold uppercase tracking-wider text-slate-400">
    <span>Progress</span>
    <span id="progress-label">0 / 5 challenges</span>
  </div>
  <div class="h-3 w-full overflow-hidden rounded-full border border-border bg-panel">
    <div
      id="progress-fill"
      class="h-full w-0 rounded-full bg-gradient-to-r from-azure-500 via-azure-400 to-gold-400 transition-[width] duration-700 ease-out"
    >
    </div>
  </div>
</div>

<script>
  import { completedCount, TOTAL_CHALLENGES } from "../scripts/gameState";

  const fill = document.getElementById("progress-fill");
  const label = document.getElementById("progress-label");
  const done = completedCount();
  const percent = Math.round((done / TOTAL_CHALLENGES) * 100);

  if (fill) fill.style.width = `${percent}%`;
  if (label) label.textContent = `${done} / ${TOTAL_CHALLENGES} challenges`;
</script>
