---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import ProgressBar from "../components/ProgressBar.astro";
import { STORY_TITLE, STORY_PARAGRAPHS, STORY_RULES } from "../data/story";
import { CHALLENGES } from "../data/challenges";
---

<BaseLayout title="Story">
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <div class="mb-8 animate-fade-up">
      <ProgressBar />
    </div>

    <Card glow class="animate-fade-up">
      <p class="mb-2 text-sm font-semibold uppercase tracking-[0.3em] text-azure-300">Chapter One</p>
      <h1 class="font-display text-3xl font-black text-gold-300 text-glow-gold sm:text-4xl">
        🏰 {STORY_TITLE}
      </h1>

      <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-300 sm:text-lg">
        {STORY_PARAGRAPHS.map((p) => <p>{p}</p>)}
      </div>

      <div class="mt-8 rounded-xl border border-border bg-panel-light/60 p-5">
        <h2 class="mb-3 font-display text-lg font-bold text-azure-300">📜 How to play</h2>
        <ul class="space-y-2 text-sm text-slate-300 sm:text-base">
          {STORY_RULES.map((rule) => (
            <li class="flex items-start gap-2">
              <span class="mt-0.5 text-gold-400" aria-hidden="true">
                ✔
              </span>
              <span>{rule}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-5">
        {CHALLENGES.map((c) => (
          <a
            href={c.path}
            class="group flex flex-col items-center gap-1 rounded-xl border border-border bg-panel px-3 py-4 text-center transition hover:-translate-y-1 hover:border-gold-500/60"
          >
            <span class="text-2xl transition group-hover:scale-110" aria-hidden="true">
              {c.icon}
            </span>
            <span class="text-xs font-semibold text-slate-300">{c.subtitle}</span>
          </a>
        ))}
      </div>

      <div class="mt-10 flex justify-center">
        <Button href="/challenge/1" variant="primary" size="lg">
          🚩 Begin Challenge 1
        </Button>
      </div>
    </Card>
  </section>
</BaseLayout>

<script>
  import { ensureStarted } from "../scripts/gameState";
  ensureStarted();
</script>
