---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
import { STORY_TITLE } from "../data/story";
---

<BaseLayout title="Welcome" description="An interactive haunted-castle escape room for English class.">
  <section class="relative flex min-h-[calc(100vh-140px)] items-center justify-center overflow-hidden px-4 py-16">
    <!-- decorative floating icons -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden opacity-40" aria-hidden="true">
      <span class="animate-float absolute left-[8%] top-[20%] text-5xl" style="animation-delay: 0s;">🏰</span>
      <span class="animate-float absolute right-[10%] top-[15%] text-5xl" style="animation-delay: 0.6s;">👻</span>
      <span class="animate-float absolute left-[15%] bottom-[18%] text-5xl" style="animation-delay: 1.2s;">🦇</span>
      <span class="animate-float absolute right-[12%] bottom-[22%] text-5xl" style="animation-delay: 1.8s;">🕯️</span>
      <span class="animate-float absolute left-1/2 top-[8%] text-4xl" style="animation-delay: 2.4s;">🗝️</span>
    </div>

    <Card glow class="animate-pop-in relative z-10 max-w-2xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.3em] text-azure-300">English Class Adventure</p>
      <h1 class="font-display text-4xl font-black text-gold-300 text-glow-gold sm:text-6xl">
        🗝️ Escape Room
      </h1>
      <p class="mt-4 font-display text-xl text-slate-200 sm:text-2xl animate-shimmer">{STORY_TITLE}</p>

      <p class="mx-auto mt-6 max-w-lg text-base leading-relaxed text-slate-300 sm:text-lg">
        Ravenswood Castle has been sealed for three hundred years. Five ghostly guardians stand between
        you and its darkest secret. Solve their challenges, collect the codes, and open the ancient chest
        before the candles burn out!
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href="/story" variant="primary" size="lg" id="start-btn">
          🏰 Start Adventure
        </Button>
        <Button href="/final" variant="ghost" size="lg">
          🗝️ Go to the Chest
        </Button>
      </div>

      <p class="mt-6 text-xs text-slate-500">Your progress is saved automatically on this device.</p>
    </Card>
  </section>
</BaseLayout>

<script>
  import { playClick } from "../scripts/sound";
  document.getElementById("start-btn")?.addEventListener("click", () => playClick());
</script>
