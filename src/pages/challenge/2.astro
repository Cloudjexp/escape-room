---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChallengeShell from "../../components/ChallengeShell.astro";
import Lock from "../../components/Lock.astro";
import Button from "../../components/Button.astro";

const SENTENCES = [
  {
    id: "g1",
    before: "Long ago, a lonely wizard",
    after: "in this tower.",
    options: ["live", "lived", "living"],
    answer: "lived",
  },
  {
    id: "g2",
    before: "Listen! Someone",
    after: "down the stairs right now.",
    options: ["walk", "walks", "is walking"],
    answer: "is walking",
  },
  {
    id: "g3",
    before: "This is",
    after: "oldest castle in the kingdom.",
    options: ["a", "an", "the"],
    answer: "the",
  },
  {
    id: "g4",
    before: "The dungeon is much",
    after: "than the tower.",
    options: ["dark", "darker", "darkest"],
    answer: "darker",
  },
  {
    id: "g5",
    before: "You",
    after: "open that door — it's cursed!",
    options: ["mustn't", "don't", "doesn't"],
    answer: "mustn't",
  },
];
---

<BaseLayout title="Challenge 2 · Grammar Challenge">
  <ChallengeShell
    id={2}
    instructions="An ancient spellbook rests on the pedestal, sealed by a magic lock. Choose the correct word to complete each spell. Get them all right to break the seal."
  >
    <div class="flex flex-col items-center gap-8 lg:flex-row lg:items-start lg:justify-between">
      <div class="w-full flex-1 space-y-3">
        {SENTENCES.map((s) => (
          <div class="flex flex-col gap-2 rounded-lg border border-border bg-panel px-4 py-3 sm:flex-row sm:items-center sm:gap-3">
            <p class="flex-1 font-mono text-sm text-slate-200 sm:text-base">
              {s.before} <span class="mx-1 text-azure-300">___</span> {s.after}
            </p>
            <select
              id={s.id}
              class="option-card rounded-md px-3 py-2 text-center font-mono text-sm text-white focus:border-azure-400 focus:outline-none sm:w-40"
            >
              <option value="" selected disabled>Choose...</option>
              {s.options.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </div>
        ))}

        <div id="grammar-feedback" class="hidden"></div>

        <div class="pt-2 text-center sm:text-left">
          <Button id="grammar-check-btn" variant="secondary" size="md">🪄 Cast the Spell</Button>
        </div>
      </div>

      <div class="flex flex-col items-center gap-2">
        <Lock id="grammar-lock" size={110} locked={true} />
        <p id="grammar-lock-status" class="text-xs font-semibold uppercase tracking-wider text-slate-400">Sealed</p>
      </div>
    </div>
  </ChallengeShell>
</BaseLayout>

<script define:vars={{ answers: SENTENCES.map((s) => ({ id: s.id, answer: s.answer })) }} is:inline>
  window.__GRAMMAR_ANSWERS__ = answers;
</script>

<script>
  import { playError } from "../../scripts/sound";
  import { showFeedback, clearFeedback } from "../../scripts/feedback";

  const answers = (window as any).__GRAMMAR_ANSWERS__ as { id: string; answer: string }[];
  const feedback = document.getElementById("grammar-feedback")!;
  const lock = document.getElementById("grammar-lock")!;
  const status = document.getElementById("grammar-lock-status")!;

  document.getElementById("grammar-check-btn")?.addEventListener("click", () => {
    let allCorrect = true;
    for (const { id, answer } of answers) {
      const select = document.getElementById(id) as HTMLSelectElement;
      const isCorrect = select.value === answer;
      select.classList.toggle("incorrect", !isCorrect && select.value !== "");
      select.classList.toggle("correct", isCorrect);
      if (!isCorrect) allCorrect = false;
    }

    if (allCorrect) {
      clearFeedback(feedback);
      lock.classList.add("is-open");
      status.textContent = "Unsealed!";
      status.classList.add("text-gold-300");
      showFeedback(feedback, "success", "The seal shimmers and breaks!");
      window.dispatchEvent(new Event("challenge:solved"));
    } else {
      showFeedback(feedback, "error", "The spell fizzles... check your grammar and try again.");
      playError();
    }
  });
</script>
