---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChallengeShell from "../../components/ChallengeShell.astro";
import Button from "../../components/Button.astro";

const PASSAGE = [
  "My name was Eleanor. I lived in the North Tower with my father, the castle's guard.",
  "One stormy night, a fire started in the kitchen, and I ran through the halls to warn everyone.",
  "I never made it out of the tower.",
  "Now I wait here, watching over the halls, hoping someone will finally hear my story.",
];

const QUESTIONS = [
  {
    id: "q1",
    question: "Where did Eleanor live?",
    options: ["The dungeon", "The North Tower", "The stables"],
    answer: "The North Tower",
  },
  {
    id: "q2",
    question: "What was her father's job?",
    options: ["A cook", "A wizard", "The castle's guard"],
    answer: "The castle's guard",
  },
  {
    id: "q3",
    question: "Why couldn't Eleanor leave the tower?",
    options: ["She was locked in", "A fire started and she didn't make it out", "She fell asleep"],
    answer: "A fire started and she didn't make it out",
  },
];
---

<BaseLayout title="Challenge 3 · Reading Comprehension">
  <ChallengeShell
    id={3}
    instructions="You find a torn diary page near a shattered mirror. Read it carefully, then answer the questions below."
  >
    <blockquote class="rounded-xl border border-azure-500/30 bg-azure-500/5 p-6 text-glow-blue">
      <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-azure-300">📔 A page from the diary</p>
      <div class="space-y-2 font-display text-base italic leading-relaxed text-slate-100 sm:text-lg">
        {PASSAGE.map((line) => <p>{line}</p>)}
      </div>
    </blockquote>

    <div class="mt-8 space-y-6">
      {QUESTIONS.map((q) => (
        <div class="rounded-xl border border-border bg-panel-light/50 p-4 sm:p-5">
          <p class="mb-3 font-semibold text-slate-100">{q.question}</p>
          <div class="grid gap-2 sm:grid-cols-1" data-question-id={q.id}>
            {q.options.map((opt) => (
              <button
                type="button"
                class="option-card rounded-lg px-4 py-2.5 text-left text-sm text-slate-300 sm:text-base"
                data-value={opt}
              >
                {opt}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div id="reading-feedback" class="hidden"></div>

    <div class="mt-6 flex justify-center">
      <Button id="reading-check-btn" variant="secondary" size="md">📖 Submit Answers</Button>
    </div>
  </ChallengeShell>
</BaseLayout>

<script define:vars={{ answers: QUESTIONS.map((q) => ({ id: q.id, answer: q.answer })) }} is:inline>
  window.__READING_ANSWERS__ = answers;
</script>

<script>
  import { playError } from "../../scripts/sound";
  import { showFeedback, clearFeedback } from "../../scripts/feedback";

  const answers = (window as any).__READING_ANSWERS__ as { id: string; answer: string }[];
  const feedback = document.getElementById("reading-feedback")!;

  document.querySelectorAll<HTMLElement>("[data-question-id]").forEach((group) => {
    group.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest("button") as HTMLButtonElement | null;
      if (!btn) return;
      group.querySelectorAll("button").forEach((b) => b.classList.remove("selected", "correct", "incorrect"));
      btn.classList.add("selected");
    });
  });

  document.getElementById("reading-check-btn")?.addEventListener("click", () => {
    let allCorrect = true;

    for (const { id, answer } of answers) {
      const group = document.querySelector(`[data-question-id="${id}"]`) as HTMLElement;
      const selected = group.querySelector(".selected") as HTMLButtonElement | null;
      const isCorrect = !!selected && selected.dataset.value === answer;

      group.querySelectorAll("button").forEach((b) => b.classList.remove("correct", "incorrect"));
      if (selected) {
        selected.classList.remove("selected");
        selected.classList.add(isCorrect ? "correct" : "incorrect");
      }
      if (!isCorrect) allCorrect = false;
    }

    if (allCorrect) {
      clearFeedback(feedback);
      showFeedback(feedback, "success", "You remember the diary perfectly. The tower reveals its code!");
      window.dispatchEvent(new Event("challenge:solved"));
    } else {
      showFeedback(feedback, "error", "Some answers are wrong. Re-read the diary and try again.");
      playError();
    }
  });
</script>
