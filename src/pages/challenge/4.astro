---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChallengeShell from "../../components/ChallengeShell.astro";
import Button from "../../components/Button.astro";

const TORCHES = [
  { id: 1, name: "Blue", color: "#4fc3ff" },
  { id: 2, name: "Gold", color: "#f4b93a" },
  { id: 3, name: "Silver", color: "#c7d2e0" },
  { id: 4, name: "Red", color: "#e2513f" },
];
// Blue is first (clue 1). Gold comes before Silver (clue 2), and Red comes
// immediately after Silver (clue 3) — the only order that fits all three
// clues is Blue, Gold, Silver, Red.
const SOLUTION_ORDER = [1, 2, 3, 4];

const CLUES = [
  "The Blue torch must be lit first.",
  "The Gold torch is lit before the Silver torch.",
  "The Red torch is lit immediately after the Silver torch.",
];
---

<BaseLayout title="Challenge 4 · Logic Puzzle">
  <ChallengeShell
    id={4}
    instructions="Four ghostly torches line the hall. Use the clues to work out the correct order, then click them one by one, first to last."
  >
    <div class="mb-6 rounded-xl border border-border bg-panel-light/50 p-5">
      <h3 class="mb-2 text-sm font-bold uppercase tracking-wider text-azure-300">Clues</h3>
      <ul class="space-y-1.5 text-sm text-slate-300 sm:text-base">
        {CLUES.map((clue) => (
          <li class="flex items-start gap-2">
            <span class="mt-0.5 text-gold-400" aria-hidden="true">🕯️</span>
            <span>{clue}</span>
          </li>
        ))}
      </ul>
    </div>

    <div id="torch-row" class="flex flex-wrap justify-center gap-4 sm:gap-6">
      {TORCHES.map((t) => (
        <button
          type="button"
          class="torch relative flex w-24 flex-col items-center gap-2 rounded-xl border border-border bg-panel px-3 py-5 transition-transform hover:-translate-y-1 sm:w-28"
          data-torch-id={t.id}
          style={`color:${t.color}`}
        >
          <span class="ripple-ring pointer-events-none absolute inset-0 hidden rounded-xl" aria-hidden="true"></span>
          <span class="order-badge hidden rounded-full border border-gold-500/60 bg-gold-500/20 px-2 py-0.5 text-xs font-bold text-gold-300"></span>
          <span class="animate-torch-flicker text-4xl" aria-hidden="true">🔥</span>
          <span class="text-xs font-semibold text-slate-300">{t.name}</span>
        </button>
      ))}
    </div>

    <div id="logic-feedback" class="hidden"></div>

    <div class="mt-6 flex justify-center">
      <Button id="torch-reset-btn" variant="ghost" size="sm">↺ Reset Torches</Button>
    </div>
  </ChallengeShell>
</BaseLayout>

<style>
  .torch.lit {
    border-color: currentColor;
    box-shadow: 0 0 24px -4px currentColor;
    background: color-mix(in srgb, currentColor 16%, var(--color-panel));
  }
  .ripple-ring {
    border: 2px solid currentColor;
  }
  .torch.lit .ripple-ring {
    display: block;
  }
  .torch.lit .order-badge {
    display: inline-flex;
  }
</style>

<script define:vars={{ solutionOrder: SOLUTION_ORDER }} is:inline>
  window.__TORCH_SOLUTION__ = solutionOrder;
</script>

<script>
  import { playClick, playError } from "../../scripts/sound";
  import { showFeedback, clearFeedback } from "../../scripts/feedback";

  const solution = (window as any).__TORCH_SOLUTION__ as number[];
  const row = document.getElementById("torch-row")!;
  const feedback = document.getElementById("logic-feedback")!;
  let selectedOrder: number[] = [];

  // Shuffle the displayed torch order so the visual left-to-right position
  // never matches the solution order the clues describe.
  const torchEls = Array.from(row.children);
  for (let i = torchEls.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [torchEls[i], torchEls[j]] = [torchEls[j], torchEls[i]];
  }
  torchEls.forEach((el) => row.appendChild(el));

  function render() {
    row.querySelectorAll<HTMLElement>(".torch").forEach((el) => {
      const id = Number(el.dataset.torchId);
      const position = selectedOrder.indexOf(id);
      const badge = el.querySelector(".order-badge")!;
      if (position === -1) {
        el.classList.remove("lit");
        badge.textContent = "";
      } else {
        el.classList.add("lit");
        badge.textContent = String(position + 1);
      }
    });
  }

  function resetSelection() {
    selectedOrder = [];
    render();
    clearFeedback(feedback);
  }

  row.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".torch") as HTMLElement | null;
    if (!btn) return;
    const id = Number(btn.dataset.torchId);

    if (selectedOrder[selectedOrder.length - 1] === id) {
      selectedOrder.pop();
      playClick();
      render();
      return;
    }
    if (selectedOrder.includes(id) || selectedOrder.length >= 4) return;

    selectedOrder.push(id);
    playClick();
    render();

    if (selectedOrder.length === 4) {
      const isCorrect = selectedOrder.every((val, i) => val === solution[i]);
      setTimeout(() => {
        if (isCorrect) {
          row.querySelectorAll(".torch").forEach((el) => el.classList.add("animate-flare"));
          showFeedback(feedback, "success", "The torches blaze bright! The shield guardian yields its code.");
          window.dispatchEvent(new Event("challenge:solved"));
        } else {
          row.querySelectorAll(".torch").forEach((el) => el.classList.add("animate-shake"));
          showFeedback(feedback, "error", "The torches flicker and go dark... study the clues and try again.");
          playError();
          setTimeout(() => {
            row.querySelectorAll(".torch").forEach((el) => el.classList.remove("animate-shake"));
            resetSelection();
          }, 700);
        }
      }, 250);
    }
  });

  document.getElementById("torch-reset-btn")?.addEventListener("click", resetSelection);
</script>
